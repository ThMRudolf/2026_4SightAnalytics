# Copy to .env (git-ignored). Values from Meta App Dashboard → WhatsApp → API Setup.
WA_TOKEN=EAAG...permanent-system-user-token
WA_PHONE_NUMBER_ID=123456789012345
WA_API_VERSION=v23.0
# Only for examples/setup_templates.py and send_test.py
WA_WABA_ID=123456789012345
WA_TEST_RECIPIENT=+5215512345678

# REST API key (header X-API-Key). Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COM2WA_API_KEY=change-me
